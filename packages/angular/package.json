{
  "name": "kai-charts-angular",
  "version": "0.5.0",
  "private": true,
  "description": "Angular CLI workspace: the kai-charts library (projects/kai-charts) and its demo app (projects/demo).",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "ng build kai-charts && node scripts/postbuild-lib.mjs",
    "build:demo": "ng build demo",
    "pack": "pnpm build && pnpm --dir dist/kai-charts pack --pack-destination ../..",
    "test": "ng test",
    "test:lib": "ng test kai-charts"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "kai-charts-core": "workspace:*",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
