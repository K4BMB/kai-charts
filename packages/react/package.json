{
  "name": "kai-charts-react",
  "version": "0.5.0",
  "description": "Dependency-free SVG chart components for React 18+: bar chart (vertical/horizontal, grouped/stacked), line chart, concentric rings, Venezuela choropleth map, KPI card, progress and ranking lists, legend, tooltip, mirror table and loading/empty states. Themed by --kc-* CSS tokens, Intl formatting, built on kai-charts-core.",
  "license": "MIT",
  "author": "Kaissar Mahfoud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/K4BMB/kai-charts.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/K4BMB/kai-charts#readme",
  "bugs": {
    "url": "https://github.com/K4BMB/kai-charts/issues"
  },
  "keywords": [
    "react",
    "charts",
    "svg",
    "bar-chart",
    "dashboard",
    "accessible",
    "intl",
    "css-tokens"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/kai-charts-react.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "kai-charts-core": "workspace:^"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
