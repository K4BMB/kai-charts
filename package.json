{
  "name": "kai-charts-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for kai-charts: dependency-free SVG charts for Angular and React, sharing a headless core.",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "build:core": "pnpm --filter kai-charts-core build",
    "test": "pnpm build:core && pnpm -r --filter=./packages/* test",
    "dev:angular": "pnpm build:core && pnpm --filter kai-charts-angular start",
    "dev:react": "pnpm build:core && pnpm --filter kai-charts-react-demo dev",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.8.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  }
}
