{
  "name": "kai-charts-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace for kai-charts: dependency-free SVG charts for Angular 20+",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "ng build kai-charts && node scripts/postbuild-lib.mjs",
    "build:demo": "ng build demo",
    "pack": "pnpm build && pnpm --dir dist/kai-charts pack --pack-destination ../..",
    "test": "ng test kai-charts",
    "test:all": "ng test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  }
}
